{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nagi/contract-evidence-v1.schema.json",
  "title": "Nagi Phase Zero redacted contract evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layer",
    "gate",
    "result",
    "revision",
    "fixture",
    "versions",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layer": {
      "enum": ["hermetic", "macos", "live-provider"]
    },
    "gate": {
      "enum": [
        "harness",
        "linear",
        "temporal",
        "codex",
        "operator-surface",
        "safety",
        "release"
      ]
    },
    "result": {
      "enum": ["pass", "fail", "skip"]
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixture": {
      "type": "string",
      "pattern": "^synthetic\\.[a-z0-9-]+\\.v[0-9]+$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "temporalCli", "temporalRustSdk", "codex"],
      "properties": {
        "rust": {
          "type": "string",
          "const": "1.98.0"
        },
        "temporalCli": {
          "type": "string",
          "const": "1.8.2"
        },
        "temporalRustSdk": {
          "type": "string",
          "const": "0.7.0"
        },
        "codex": {
          "type": "string",
          "const": "0.151.0"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result"],
        "properties": {
          "name": {
            "enum": [
              "fixture-provenance",
              "version-pins",
              "boundary",
              "redaction",
              "preflight"
            ]
          },
          "result": {
            "enum": ["pass", "fail", "skip"]
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "not-configured",
            "unsupported-host",
            "not-implemented",
            "contract-failed"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["result"],
        "properties": {
          "result": {
            "const": "fail"
          }
        }
      },
      "then": {
        "required": ["failure"],
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": {
                  "const": "fail"
                }
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": ["failure"]
        }
      }
    },
    {
      "if": {
        "required": ["result"],
        "properties": {
          "result": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["result"],
        "properties": {
          "result": {
            "const": "skip"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": {
                  "enum": ["pass", "skip"]
                }
              }
            },
            "contains": {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": {
                  "const": "skip"
                }
              }
            }
          }
        }
      }
    }
  ]
}
